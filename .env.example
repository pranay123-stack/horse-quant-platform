# ---------------------------------------------------------------------------
# Horse Quant Platform -- environment template
#
#   cp .env.example .env      then fill in the real values
#
# .env is git-ignored. NEVER commit real credentials.
# ---------------------------------------------------------------------------

# --- Application -----------------------------------------------------------
APP_NAME="Horse Quant Platform"
APP_VERSION=0.1.0
ENVIRONMENT=local              # local | test | dev | staging | prod
DEBUG=true
TIMEZONE=Europe/London

API_HOST=0.0.0.0
API_PORT=8000
API_V1_PREFIX=/api/v1
API_WORKERS=1
CORS_ORIGINS=http://localhost:3000,http://localhost:8501

# --- Logging ---------------------------------------------------------------
LOG_LEVEL=INFO                 # DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_DIR=logs
LOG_JSON=false                 # true in staging/prod for structured shipping
LOG_TO_CONSOLE=true
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# --- PostgreSQL ------------------------------------------------------------
POSTGRES_HOST=localhost        # use "postgres" when running inside docker compose
POSTGRES_PORT=5432
POSTGRES_USER=horse_quant
POSTGRES_PASSWORD=change_me_locally
POSTGRES_DB=horse_quant
# Optional single-URL override; wins over the five variables above.
# DATABASE_URL=postgresql+psycopg2://user:pass@host:5432/dbname

DB_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE_SECONDS=1800
DB_STATEMENT_TIMEOUT_MS=30000

# --- Redis / Celery (Phase 10) --------------------------------------------
REDIS_HOST=localhost           # "redis" inside docker compose
REDIS_PORT=6379
REDIS_DB=0
# CELERY_BROKER_URL=
# CELERY_RESULT_BACKEND=

# --- The Racing API (Phase 2) ---------------------------------------------
# Sign up at https://www.theracingapi.com -- credentials are per-account.
RACING_API_BASE_URL=https://api.theracingapi.com
RACING_API_USERNAME=
RACING_API_PASSWORD=
RACING_API_KEY=
RACING_API_TIMEOUT_SECONDS=30
RACING_API_MAX_RETRIES=5
RACING_API_BACKOFF_FACTOR=0.5
RACING_API_RATE_LIMIT_PER_SECOND=2

# --- Data & model artefacts ------------------------------------------------
DATA_DIR=data
MODELS_DIR=models
REPORTS_DIR=reports
ACTIVE_MODEL_VERSION=baseline_v1

# --- Betting / risk defaults (Phases 7-8) ---------------------------------
STARTING_BANKROLL=10000
MIN_EXPECTED_VALUE=0.05        # only signal a bet when EV > 5%
MIN_MODEL_PROBABILITY=0.02
MAX_ODDS=51
KELLY_FRACTION=0.25            # quarter-Kelly
MAX_STAKE_FRACTION=0.05        # never risk more than 5% of bankroll on one bet
FLAT_STAKE=10

# --- Security (Phase 10) ---------------------------------------------------
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=720
